                            <p>Bajarejo, Pudak, Ponorogo atau Slahung, Slahung, Ponorogo</p>
                        </div>
                    </div>
                    <div class="kontak-item">
                        <div class="icon-item">📱</div>
                        <div>
                            <h4>WhatsApp</h4>
                            <p>0812-3456-7890</p>
                        </div>
                    </div>
                    <div class="kontak-item">
                        <div class="icon-item">🕐</div>
                        <div>
