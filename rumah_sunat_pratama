    <!-- Footer -->
    <footer>
        <p class="brand">🏥 Rumah Sunat Pratama</p>
        <p class="tagline">Khitan Modern, Aman, dan Nyaman untuk Putra Anda</p>
        <p class="copy">© 2026 Rumah Sunat Pratama. All rights reserved.</p>
    </footer>

    <!-- Toast -->
    <div id="toast" class="toast"></div>

    <script>
        // Data storage
        let pendaftarList = JSON.parse(localStorage.getItem('rsp_pendaftar')) || [];
        let currentPendaftar = null;

        function showPage(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-links button').forEach(b => b.classList.remove('active'));
            document.getElementById('page-' + page).classList.add('active');
            document.querySelector('[data-page="' + page + '"]').classList.add('active');
            window.scrollTo(0, 0);

            if (page === 'riwayat') renderRiwayat();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function submitForm(e) {
            e.preventDefault();

            const data = {
                id: Date.now(),
                namaAnak: document.getElementById('namaAnak').value,
                umur: document.getElementById('umur').value,
                berat: document.getElementById('berat').value,
                namaOrtu: document.getElementById('namaOrtu').value,
                alamat: document.getElementById('alamat').value,
                alergi: document.getElementById('alergi').value || 'Tidak ada',
                tglKhitan: document.getElementById('tglKhitan').value,
                jamKhitan: document.getElementById('jamKhitan').value,
                layanan: document.getElementById('layanan').value,
                sumber: document.getElementById('sumber').value,
                tglDaftar: new Date().toISOString()
            };

            // Save to localStorage
            pendaftarList.push(data);
            localStorage.setItem('rsp_pendaftar', JSON.stringify(pendaftarList));
            currentPendaftar = data;

            // Fill certificate
            fillCertificate(data);

            // Reset form
            document.getElementById('form-daftar').reset();

            // Show certificate page
            showPage('sertifikat');
            showToast('Pendaftaran berhasil disimpan!');
        }

        function fillCertificate(data) {
            const dateObj = new Date(data.tglKhitan);
            const hariList = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
            const bulanList = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
            const hari = hariList[dateObj.getDay()];
            const tanggal = dateObj.getDate() + ' ' + bulanList[dateObj.getMonth()] + ' ' + dateObj.getFullYear();

            const noReg = 'RSP-' + dateObj.getFullYear() + '-' + String(Math.floor(Math.random() * 900) + 100);

            const now = new Date(data.tglDaftar);
            const tglDaftar = now.getDate() + ' ' + bulanList[now.getMonth()] + ' ' + now.getFullYear();

            document.getElementById('cert-nama').textContent = data.namaAnak;
            document.getElementById('cert-hari').textContent = hari;
            document.getElementById('cert-tanggal').textContent = tanggal;
            document.getElementById('cert-jam').textContent = data.jamKhitan + ' WIB';
            document.getElementById('cert-umur').textContent = data.umur;
            document.getElementById('cert-berat').textContent = data.berat;
            document.getElementById('cert-ortu').textContent = data.namaOrtu;
            document.getElementById('cert-layanan').textContent = data.layanan;
            document.getElementById('cert-noreg').textContent = noReg;
            document.getElementById('cert-tgldaftar').textContent = tglDaftar;
        }

        function printSertifikat() {
            const sertifikat = document.getElementById('sertifikat-card').cloneNode(true);
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`
                <html>
                <head>
                    <title>Sertifikat Khitan - Rumah Sunat Pratama</title>
                    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
                    <style>
                        @media print { body { margin: 0; padding: 20px; } .cert { page-break-inside: avoid; } }
                        body { font-family: 'Playfair Display', Georgia, serif; background: #f5f5f5; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
                    </style>
                </head>
                <body>
                    <div class="cert">${sertifikat.outerHTML}</div>
                </body>
                </html>
            `);
            printWindow.document.close();
            setTimeout(() => printWindow.print(), 500);
        }

        function renderRiwayat() {
            const container = document.getElementById('riwayat-content');
            if (pendaftarList.length === 0) {
                container.innerHTML = `
                    <div class="riwayat-empty">
                        <div class="icon">📭</div>
                        <p>Belum ada data pendaftaran</p>
                    </div>`;
                return;
            }

            const bulanList = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
            let html = `<table class="riwayat-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Nama Anak</th>
                        <th>Umur</th>
                        <th>Tanggal Khitan</th>
                        <th>Layanan</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>`;

            pendaftarList.slice().reverse().forEach((p, i) => {
                const d = new Date(p.tglKhitan);
                const tgl = d.getDate() + ' ' + bulanList[d.getMonth()] + ' ' + d.getFullYear();
                const badgeClass = p.layanan === 'Panggilan ke Rumah' ? 'badge-panggil' : 'badge-praktik';
                html += `<tr>
                    <td>${i + 1}</td>
                    <td><strong>${p.namaAnak}</strong></td>
                    <td>${p.umur} th</td>
                    <td>${tgl}</td>
                    <td><span class="badge ${badgeClass}">${p.layanan}</span></td>
                    <td>
                        <button class="btn-small btn-view" onclick="viewDetail(${p.id})">Lihat</button>
                        <button class="btn-small btn-delete" onclick="deletePendaftar(${p.id})">Hapus</button>
                    </td>
                </tr>`;
            });

            html += `</tbody></table>`;
            container.innerHTML = html;
        }

        function viewDetail(id) {
            const p = pendaftarList.find(x => x.id === id);
            if (!p) return;
            currentPendaftar = p;
            fillCertificate(p);
            showPage('sertifikat');
        }

        function deletePendaftar(id) {
            if (!confirm('Yakin ingin menghapus data ini?')) return;
            pendaftarList = pendaftarList.filter(x => x.id !== id);
            localStorage.setItem('rsp_pendaftar', JSON.stringify(pendaftarList));
            renderRiwayat();
            showToast('Data berhasil dihapus');
        }
    </script>
</body>
</html>
