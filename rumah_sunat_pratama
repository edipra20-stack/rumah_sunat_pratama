                        <div class="line"></div>
                        <p class="sub">Rumah Sunat Pratama</p>
                    </div>

                    <div class="cert-body">
                        <p class="intro">Dengan ini dinyatakan bahwa:</p>
                        <h2 class="nama-anak" id="cert-nama">Nama Anak</h2>
                        <p class="detail">Telah menjalani khitan pada hari <strong id="cert-hari">Senin</strong></p>
                        <p class="detail">Tanggal <strong id="cert-tanggal">1 Januari 2026</strong> pukul <strong id="cert-jam">08:00 WIB</strong></p>

                        <div class="detail-box">
                            <p class="label">Detail Pendaftaran:</p>
                            <p>Umur: <strong id="cert-umur">7</strong> tahun | Berat: <strong id="cert-berat">25</strong> kg</p>
                            <p>Orang Tua: <strong id="cert-ortu">Nama Ortu</strong></p>
                            <p>Layanan: <strong id="cert-layanan">Datang ke Praktik</strong></p>
                        </div>

                        <p class="doa">"Semoga menjadi anak yang shaleh dan berbakti"</p>
                    </div>

                    <div class="cert-footer">
                        <div class="info">
                            <p>No. Reg: <strong id="cert-noreg">RSP-2026-001</strong></p>
                            <p>Didaftarkan: <span id="cert-tgldaftar">29 Agustus 2026</span></p>
                        </div>
                        <div class="stamp"><span>🏥</span></div>
                        <div class="ttd">
                            <div class="line"></div>
                            <p>Tanda Tangan</p>
                            <p class="nama">Edi Prayitno,A.Md.Kep</p>
                        </div>
                    </div>
                </div>

                <div class="cert-actions">
                    <button onclick="printSertifikat()" class="btn-print">🖨️ Cetak Sertifikat</button>
                    <button onclick="showPage('home')" class="btn-secondary">🏠 Kembali ke Beranda</button>
                </div>
            </div>
        </div>
    </div>

    <!-- RIWAYAT PAGE -->
    <div id="page-riwayat" class="page">
        <div class="riwayat-container">
            <div class="riwayat-box">
                <div class="riwayat-header">
                    <h2>📋 Riwayat Pendaftaran</h2>
                    <p>Daftar semua pendaftar khitan yang tersimpan</p>
                </div>
                <div id="riwayat-content">
                    <div class="riwayat-empty">
                        <div class="icon">📭</div>
                        <p>Belum ada data pendaftaran</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KONTAK PAGE -->
    <div id="page-kontak" class="page">
        <div class="kontak-container">
            <div class="kontak-box">
                <div class="icon">📞</div>
                <h2>Hubungi Kami</h2>
                <p>Konsultasi dan informasi lebih lanjut</p>

                <div style="text-align: left; margin-bottom: 24px;">
                    <div class="kontak-item">
                        <div class="icon-item">📍</div>
                        <div>
