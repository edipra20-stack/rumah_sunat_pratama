<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rumah Sunat Pratama - Khitan Modern, Aman & menyenangkan</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', sans-serif; background: #f8fafc; color: #1e293b; }

        /* Navbar */
        .navbar {
            background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%);
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            border-radius: 0 0 20px 20px;
            box-shadow: 0 4px 20px rgba(15,118,110,0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .navbar-brand { display: flex; align-items: center; gap: 12px; }
        .navbar-brand .logo {
            width: 44px; height: 44px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .navbar-brand h1 { font-size: 20px; font-weight: 700; letter-spacing: 0.5px; }
        .navbar-brand p { font-size: 11px; opacity: 0.9; letter-spacing: 1px; margin: 0; }
        .nav-links { display: flex; gap: 12px; }
        .nav-links button {
            background: rgba(255,255,255,0.15);
            border: none;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 500;
            font-family: 'Poppins', sans-serif;
            transition: all 0.3s;
        }
        .nav-links button:hover, .nav-links button.active {
            background: rgba(255,255,255,0.3);
        }

        /* Pages */
        .page { display: none; padding: 0; }
        .page.active { display: block; }

        /* Hero */
        .hero {
            background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%);
            padding: 60px 24px;
            text-align: center;
            border-radius: 0 0 40px 40px;
            margin-bottom: 30px;
        }
        .hero-icon { font-size: 64px; margin-bottom: 16px; }
        .hero h2 { color: #134e4a; font-size: 32px; margin: 0 0 12px 0; font-weight: 800; }
        .hero p { color: #0f766e; font-size: 16px; max-width: 500px; margin: 0 auto 28px auto; line-height: 1.6; }
        .hero-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
        .btn-primary {
            background: linear-gradient(135deg, #0f766e, #134e4a);
            color: white; border: none; padding: 14px 32px;
            border-radius: 30px; font-size: 16px; font-weight: 700;
            cursor: pointer; box-shadow: 0 4px 15px rgba(15,118,110,0.3);
            text-decoration: none; display: inline-block;
            transition: transform 0.2s, box-shadow 0.2s;
            font-family: 'Poppins', sans-serif;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(15,118,110,0.4); }
        .btn-wa {
            background: #22c55e; color: white; border: none;
            padding: 14px 32px; border-radius: 30px;
            font-size: 16px; font-weight: 700; cursor: pointer;
            text-decoration: none; display: inline-block;
            box-shadow: 0 4px 15px rgba(34,197,94,0.3);
            font-family: 'Poppins', sans-serif;
            transition: transform 0.2s;
        }
        .btn-wa:hover { transform: translateY(-2px); }

        /* Features */
        .features { padding: 20px 24px 40px; max-width: 1000px; margin: 0 auto; }
        .features h3 { text-align: center; color: #134e4a; font-size: 24px; margin-bottom: 32px; }
        .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
        .feature-card {
            background: #f0fdfa; padding: 24px; border-radius: 16px;
            text-align: center; border: 1px solid #99f6e4;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .feature-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(15,118,110,0.15); }
        .feature-card .icon { font-size: 40px; margin-bottom: 12px; }
        .feature-card h4 { color: #134e4a; margin: 0 0 8px 0; }
        .feature-card p { color: #5c7c79; font-size: 14px; margin: 0; }

        /* Testimonials */
        .testimonials {
            background: #f8fafc; padding: 40px 24px; border-radius: 24px;
            margin: 0 24px 40px; max-width: 1000px; margin-left: auto; margin-right: auto;
        }
        .testimonials h3 { text-align: center; color: #134e4a; font-size: 24px; margin-bottom: 24px; }
        .testi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
        .testi-card {
            background: white; padding: 20px; border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .testi-card p { color: #475569; font-style: italic; margin: 0 0 12px 0; }
        .testi-card .author { color: #134e4a; font-weight: 700; margin: 0; }

        /* Form */
        .form-container { padding: 30px 24px; max-width: 700px; margin: 0 auto; }
        .form-box {
            background: white; padding: 32px; border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;
        }
        .form-header { text-align: center; margin-bottom: 28px; }
        .form-header .icon { font-size: 48px; margin-bottom: 8px; }
        .form-header h2 { color: #134e4a; margin: 0; font-size: 26px; }
        .form-header p { color: #64748b; margin: 8px 0 0 0; }

        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block; color: #334155; font-weight: 600;
            margin-bottom: 6px; font-size: 14px;
        }
        .form-group label .required { color: #ef4444; }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%; padding: 12px 14px;
            border: 2px solid #e2e8f0; border-radius: 10px;
            font-size: 15px; font-family: 'Poppins', sans-serif;
            transition: border-color 0.3s; box-sizing: border-box;
        }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            outline: none; border-color: #0f766e;
        }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

        .btn-submit {
            width: 100%; background: linear-gradient(135deg, #0f766e, #134e4a);
            color: white; border: none; padding: 14px;
            border-radius: 12px; font-size: 16px; font-weight: 700;
            cursor: pointer; box-shadow: 0 4px 15px rgba(15,118,110,0.3);
            font-family: 'Poppins', sans-serif;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(15,118,110,0.4); }

        /* Sertifikat */
        .cert-page { padding: 30px 24px; text-align: center; }
        .cert-container { max-width: 800px; margin: 0 auto; }
        .cert-container h2 { color: #134e4a; margin-bottom: 8px; }
        .cert-container > p { color: #64748b; margin-bottom: 24px; }

        .sertifikat {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 30%, #fffbeb 70%, #fef3c7 100%);
            border: 8px double #b45309; border-radius: 4px;
            padding: 48px 40px; position: relative;
            box-shadow: 0 8px 32px rgba(0,0,0,0.15); margin-bottom: 24px;
            font-family: 'Playfair Display', Georgia, serif;
        }
        .corner { position: absolute; width: 60px; height: 60px; }
        .corner-tl { top: 12px; left: 12px; border-top: 4px solid #b45309; border-left: 4px solid #b45309; }
        .corner-tr { top: 12px; right: 12px; border-top: 4px solid #b45309; border-right: 4px solid #b45309; }
        .corner-bl { bottom: 12px; left: 12px; border-bottom: 4px solid #b45309; border-left: 4px solid #b45309; }
        .corner-br { bottom: 12px; right: 12px; border-bottom: 4px solid #b45309; border-right: 4px solid #b45309; }

        .cert-header { text-align: center; margin-bottom: 20px; }
        .cert-header .icon { font-size: 48px; margin-bottom: 8px; }
        .cert-header h1 { color: #92400e; font-size: 28px; margin: 0; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }
        .cert-header .line { width: 120px; height: 3px; background: linear-gradient(90deg, transparent, #b45309, transparent); margin: 12px auto; }
        .cert-header .sub { color: #92400e; font-size: 14px; margin: 0; font-style: italic; }

        .cert-body { padding: 20px 0; }
        .cert-body .intro { color: #78350f; font-size: 16px; margin: 0 0 16px 0; }
        .cert-body .nama-anak { color: #92400e; font-size: 32px; margin: 16px 0; font-weight: 700; text-decoration: underline; text-decoration-color: #b45309; text-underline-offset: 8px; }
        .cert-body .detail { color: #78350f; font-size: 15px; margin: 8px 0; }
        .cert-body .detail-box {
            background: rgba(180,83,9,0.1); border-radius: 12px;
            padding: 16px; margin: 20px 40px; border: 1px dashed #b45309;
        }
        .cert-body .detail-box p { color: #78350f; font-size: 13px; margin: 4px 0; }
        .cert-body .detail-box .label { color: #92400e; font-size: 13px; margin: 0 0 4px 0; font-weight: 600; }
        .cert-body .doa { color: #92400e; font-size: 16px; margin: 24px 0 0 0; font-style: italic; }

        .cert-footer {
            display: flex; justify-content: space-between;
            align-items: flex-end; margin-top: 32px; padding: 0 20px;
        }
        .cert-footer .info { text-align: left; }
        .cert-footer .info p { color: #78350f; font-size: 12px; margin: 0; }
        .cert-footer .stamp {
            width: 100px; height: 100px;
            border: 2px solid #b45309; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background: rgba(180,83,9,0.05);
        }
        .cert-footer .stamp span { font-size: 40px; }
        .cert-footer .ttd { text-align: center; }
        .cert-footer .ttd .line { height: 50px; border-bottom: 1px solid #92400e; width: 120px; margin: 0 auto; }
        .cert-footer .ttd p { color: #78350f; font-size: 12px; margin: 4px 0 0 0; }
        .cert-footer .ttd .nama { color: #92400e; font-size: 12px; margin: 0; font-weight: 700; }

        .cert-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
        .btn-print {
            background: linear-gradient(135deg, #0f766e, #134e4a);
            color: white; border: none; padding: 12px 28px;
            border-radius: 10px; font-size: 15px; font-weight: 700;
            cursor: pointer; box-shadow: 0 4px 12px rgba(15,118,110,0.3);
            font-family: 'Poppins', sans-serif;
        }
        .btn-secondary {
            background: #f1f5f9; color: #334155;
            border: 2px solid #cbd5e1; padding: 12px 28px;
            border-radius: 10px; font-size: 15px; font-weight: 600;
            cursor: pointer; font-family: 'Poppins', sans-serif;
        }

        /* Kontak */
        .kontak-container { padding: 30px 24px; max-width: 600px; margin: 0 auto; }
        .kontak-box {
            background: white; padding: 32px; border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;
            text-align: center;
        }
        .kontak-box .icon { font-size: 48px; margin-bottom: 12px; }
        .kontak-box h2 { color: #134e4a; margin: 0 0 8px 0; }
        .kontak-box > p { color: #64748b; margin: 0 0 28px 0; }
        .kontak-item {
            display: flex; align-items: center; gap: 16px;
            padding: 16px; background: #f0fdfa;
            border-radius: 12px; margin-bottom: 12px; text-align: left;
        }
        .kontak-item .icon-item { font-size: 28px; }
        .kontak-item h4 { color: #334155; font-weight: 600; margin: 0; }
        .kontak-item p { color: #64748b; margin: 4px 0 0 0; font-size: 14px; }
        .kontak-box .btn-wa-full {
            display: block; background: #22c55e; color: white;
            border: none; padding: 14px 32px; border-radius: 12px;
            font-size: 16px; font-weight: 700; cursor: pointer;
            text-decoration: none; box-shadow: 0 4px 15px rgba(34,197,94,0.3);
            font-family: 'Poppins', sans-serif; margin-top: 8px;
            transition: transform 0.2s;
        }
        .kontak-box .btn-wa-full:hover { transform: translateY(-2px); }

        /* Riwayat */
        .riwayat-container { padding: 30px 24px; max-width: 1000px; margin: 0 auto; }
        .riwayat-box {
            background: white; padding: 32px; border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;
        }
        .riwayat-header { text-align: center; margin-bottom: 24px; }
        .riwayat-header h2 { color: #134e4a; margin: 0; }
        .riwayat-header p { color: #64748b; margin: 8px 0 0 0; }
        .riwayat-empty { text-align: center; padding: 40px; color: #94a3b8; }
        .riwayat-empty .icon { font-size: 48px; margin-bottom: 12px; }
        .riwayat-table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        .riwayat-table th {
            background: #f0fdfa; color: #134e4a; padding: 12px;
            text-align: left; font-size: 13px; border-bottom: 2px solid #99f6e4;
        }
        .riwayat-table td {
            padding: 12px; border-bottom: 1px solid #e2e8f0;
            font-size: 14px; color: #334155;
        }
        .riwayat-table tr:hover { background: #f8fafc; }
        .badge {
            display: inline-block; padding: 4px 10px;
            border-radius: 20px; font-size: 12px; font-weight: 600;
        }
        .badge-panggil { background: #dbeafe; color: #1e40af; }
        .badge-praktik { background: #dcfce7; color: #166534; }
        .btn-small {
            padding: 6px 12px; border-radius: 6px; border: none;
            cursor: pointer; font-size: 12px; font-weight: 600;
            font-family: 'Poppins', sans-serif;
        }
        .btn-view { background: #0f766e; color: white; }
        .btn-delete { background: #fee2e2; color: #991b1b; }

        /* Footer */
        footer {
            background: #134e4a; color: white;
            padding: 24px; text-align: center;
            margin-top: 40px; border-radius: 20px 20px 0 0;
        }
        footer p { margin: 0; }
        footer .brand { font-weight: 600; margin-bottom: 8px; }
        footer .tagline { font-size: 13px; opacity: 0.8; }
        footer .copy { margin-top: 12px; font-size: 12px; opacity: 0.6; }

        /* Toast */
        .toast {
            position: fixed; bottom: 24px; right: 24px;
            background: #134e4a; color: white;
            padding: 14px 24px; border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            display: none; z-index: 1000;
            animation: slideIn 0.3s ease;
        }
        .toast.show { display: block; }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        @media (max-width: 640px) {
            .form-row { grid-template-columns: 1fr; }
            .cert-footer { flex-direction: column; align-items: center; gap: 16px; }
            .cert-footer .info { text-align: center; }
            .nav-links { gap: 6px; }
            .nav-links button { padding: 6px 10px; font-size: 13px; }
            .hero h2 { font-size: 24px; }
            .navbar-brand h1 { font-size: 16px; }
            .riwayat-table { font-size: 12px; }
            .riwayat-table th, .riwayat-table td { padding: 8px; }
        }
    </style>
<base target="_blank">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-brand">
            <div class="logo">🏥</div>
            <div>
                <h1>RUMAH SUNAT PRATAMA</h1>
                <p>KHITAN MODERN, AMAN & MENYENANGKAN</p>
            </div>
        </div>
        <div class="nav-links">
            <button onclick="showPage('home')" data-page="home">Beranda</button>
            <button onclick="showPage('daftar')" data-page="daftar">Daftar</button>
            <button onclick="showPage('riwayat')" data-page="riwayat">Riwayat</button>
            <button onclick="showPage('kontak')" data-page="kontak">Kontak</button>
        </div>
    </nav>

    <!-- HOME PAGE -->
    <div id="page-home" class="page active">
        <div class="hero">
            <div class="hero-icon">🩺</div>
            <h2>Rumah Sunat Pratama</h2>
            <p>Layanan khitan modern, steril, dan nyaman dengan tenaga medis profesional. Kami hadir untuk memberikan pengalaman khitan terbaik bagi putra Anda.</p>
            <div class="hero-buttons">
                <button onclick="showPage('daftar')" class="btn-primary">📋 Daftar Sekarang</button>
                <a href="https://wa.me/6282234795114?text=Halo%20Rumah%20Sunat%20Pratama,%20saya%20ingin%20konsultasi%20tentang%20khitanan" target="_blank" class="btn-wa">💬 Konsultasi WA</a>
            </div>
        </div>

        <div class="features">
            <h3>Mengapa Memilih Kami?</h3>
            <div class="feature-grid">
                <div class="feature-card">
                    <div class="icon">✅</div>
                    <h4>Steril & Higienis</h4>
                    <p>Alat medis steril dan ruangan bersih standar rumah sakit</p>
                </div>
                <div class="feature-card">
                    <div class="icon">👨‍⚕️</div>
                    <h4>Tenaga Medis Profesional</h4>
                    <p>Dilayani oleh tenaga medis berpengalaman dan bersertifikat</p>
                </div>
                <div class="feature-card">
                    <div class="icon">🏠</div>
                    <h4>Pelayanan ke Rumah</h4>
                    <p>Bisa dipanggil ke rumah atau datang langsung ke praktik</p>
                </div>
                <div class="feature-card">
                    <div class="icon">📜</div>
                    <h4>Sertifikat Khitan</h4>
                    <p>Mendapatkan sertifikat resmi yang bisa dicetak</p>
                </div>
            </div>
        </div>

        <div class="testimonials">
            <h3>Testimoni Orang Tua</h3>
            <div class="testi-grid">
                <div class="testi-card">
                    <p>"Pelayanan sangat ramah, anak saya tidak rewel sama sekali. Prosesnya cepat dan steril."</p>
                    <p class="author">— Bapak Ahmad, ponorogo</p>
                </div>
                <div class="testi-card">
                    <p>"Sertifikatnya bagus dan bisa langsung dicetak. Sangat recommended!"</p>
                    <p class="author">— Ibu Siti, wates slahung</p>
                </div>
                <div class="testi-card">
                    <p>"Khitan di rumah jadi lebih nyaman. Timnya datang tepat waktu."</p>
                    <p class="author">— Bapak Ridwan, babadan</p>
                </div>
            </div>
        </div>
    </div>

    <!-- DAFTAR PAGE -->
    <div id="page-daftar" class="page">
        <div class="form-container">
            <div class="form-box">
                <div class="form-header">
                    <div class="icon">📋</div>
                    <h2>Formulir Pendaftaran Khitan</h2>
                    <p>Isi data dengan lengkap untuk proses pendaftaran</p>
                </div>

                <form id="form-daftar" onsubmit="submitForm(event)">
                    <div class="form-group">
                        <label>Nama Anak <span class="required">*</span></label>
                        <input type="text" id="namaAnak" required placeholder="Masukkan nama lengkap anak">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Umur (tahun) <span class="required">*</span></label>
                            <input type="number" id="umur" required min="0" max="20" placeholder="Contoh: 7">
                        </div>
                        <div class="form-group">
                            <label>Berat Badan (kg) <span class="required">*</span></label>
                            <input type="number" id="berat" required min="1" max="100" step="0.1" placeholder="Contoh: 25.5">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Nama Orang Tua <span class="required">*</span></label>
                        <input type="text" id="namaOrtu" required placeholder="Masukkan nama orang tua/wali">
                    </div>

                    <div class="form-group">
                        <label>Alamat Lengkap <span class="required">*</span></label>
                        <textarea id="alamat" required rows="3" placeholder="Masukkan alamat lengkap"></textarea>
                    </div>

                    <div class="form-group">
                        <label>Riwayat Alergi</label>
                        <textarea id="alergi" rows="2" placeholder="Jika tidak ada, tulis 'Tidak ada'"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Tanggal Khitan <span class="required">*</span></label>
                            <input type="date" id="tglKhitan" required>
                        </div>
                        <div class="form-group">
                            <label>Jam Khitan <span class="required">*</span></label>
                            <input type="time" id="jamKhitan" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Layanan <span class="required">*</span></label>
                        <select id="layanan" required>
                            <option value="">Pilih layanan...</option>
                            <option value="Panggilan ke Rumah">🏠 Panggilan ke Rumah</option>
                            <option value="Datang ke Praktik">🏥 Datang ke Praktik</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Tahu Rumah Sunat Pratama Dari <span class="required">*</span></label>
                        <select id="sumber" required>
                            <option value="">Pilih sumber informasi...</option>
                            <option value="Google">🔍 Google / Search Engine</option>
                            <option value="Instagram">📸 Instagram</option>
                            <option value="Facebook">📘 Facebook</option>
                            <option value="TikTok">🎵 TikTok</option>
                            <option value="Teman/Keluarga">👥 Teman / Keluarga</option>
                            <option value="Spanduk/Brosur">📄 Spanduk / Brosur</option>
                            <option value="Lainnya">✨ Lainnya</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-submit">✅ Daftar Sekarang</button>
                </form>
            </div>
        </div>
    </div>

    <!-- SERTIFIKAT PAGE -->
    <div id="page-sertifikat" class="page">
        <div class="cert-page">
            <div class="cert-container">
                <h2>🎉 Pendaftaran Berhasil!</h2>
                <p>Berikut adalah sertifikat khitanan yang bisa Anda cetak</p>

                <div class="sertifikat" id="sertifikat-card">
                    <div class="corner corner-tl"></div>
                    <div class="corner corner-tr"></div>
                    <div class="corner corner-bl"></div>
                    <div class="corner corner-br"></div>

                    <div class="cert-header">
                        <div class="icon">☪️</div>
